<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calorieapp.controllers.StreakController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 15px; -fx-background-color: #2c3e50;">
            <Button fx:id="backButton" text="← Back to Profile" onAction="#handleBack"/>
            <Label fx:id="titleLabel" text="Streak Calendar"
                   style="-fx-font-size: 20px; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20px;">

            <!-- Month navigation -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="← Prev" onAction="#handlePrevMonth"/>
                <Label fx:id="monthLabel" text="June 2026"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Button text="Next →" onAction="#handleNextMonth"/>
            </HBox>
            <!-- Day of week headers -->
            <GridPane fx:id="calendarGrid" hgap="5" vgap="5" alignment="CENTER"/>
        </VBox>
    </center>
</BorderPane>
