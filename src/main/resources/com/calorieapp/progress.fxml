<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calorieapp.controllers.ProgressController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 15px; -fx-background-color: #2c3e50;">
            <Button fx:id="backButton" text="← Back to Profile" onAction="#handleBack"/>
            <Label fx:id="titleLabel" text="Progress"
                   style="-fx-font-size: 20px; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" style="-fx-padding: 30px;">

            <Label fx:id="currentWeightLabel" text="Current Weight: --"
                   style="-fx-font-size: 16px;"/>

            <Label fx:id="goalWeightLabel" text="Goal Weight: --"
                   style="-fx-font-size: 16px;"/>

            <Label fx:id="remainingLabel" text="Remaining: --"
                   style="-fx-font-size: 16px;"/>

            <ProgressBar fx:id="progressBar" prefWidth="400" prefHeight="25"/>

            <Label fx:id="progressLabel" text="0% to goal"
                   style="-fx-font-size: 14px; -fx-text-fill: gray;"/>

            <Label fx:id="predictionLabel" text="Predicted completion: --"
                   style="-fx-font-size: 14px; -fx-text-fill: gray;"/>

        </VBox>
    </center>
</BorderPane>
